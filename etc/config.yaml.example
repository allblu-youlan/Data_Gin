App:
  Name: gin-biz-web-api
  Env: ${ENV:-local}
  Debug: ${DEBUG:-true}
  Url: ${APP_URL:-http://localhost:8501}
  Port: ${APP_PORT:-8501}
  GinRunMode: ${GIN_MODE:-debug}
  ContextTimeout: 60
  SSL:
    Enabled: ${SSL_ENABLED:-false}
    Domain: ${SSL_DOMAIN:-your-domain.com}
    CertFile: ssl/cert.pem
    KeyFile: ssl/key.pem
    Port: ${SSL_PORT:-443}
Log:
  Type: daily
  MaxAge: 7
  MaxSize: 64
JWT:
  ExpireTime: 1440
  MaxRefreshTime: 86400
Email:
  Host: ${EMAIL_HOST:-smtp.example.com}
  Port: ${EMAIL_PORT:-465}
  UserName: ${EMAIL_USERNAME:-}
  Password: ${EMAIL_PASSWORD:-}
  FromAddress: ${EMAIL_FROM_ADDRESS:-}
  FromName: ${EMAIL_FROM_NAME:-}
DB:
  Driver: mysql
  # Production: use a private, highly available MySQL cluster DNS endpoint.
  Host: ${DB_HOST:-127.0.0.1}
  Port: ${DB_PORT:-3306}
  Database: ${DB_DATABASE:-your_database}
  Charset: utf8mb4
  MaxOpenConnections: ${DB_MAX_OPEN_CONNECTIONS:-25}
  MaxIdleConnections: ${DB_MAX_IDLE_CONNECTIONS:-10}
  MaxLifeSeconds: ${DB_MAX_LIFE_SECONDS:-300}
  MaxIdleSeconds: ${DB_MAX_IDLE_SECONDS:-90}
  ConnectTimeoutSeconds: ${DB_CONNECT_TIMEOUT_SECONDS:-5}
  ReadTimeoutSeconds: ${DB_READ_TIMEOUT_SECONDS:-30}
  WriteTimeoutSeconds: ${DB_WRITE_TIMEOUT_SECONDS:-30}
  MigrationIOTimeoutSeconds: ${DB_MIGRATION_IO_TIMEOUT_SECONDS:-1800}
  RejectReadOnly: ${DB_REJECT_READ_ONLY:-true}
Redis:
  Host: ${REDIS_HOST:-127.0.0.1}
  Port: ${REDIS_PORT:-6379}
  DB: 0
Cache:
  Host: ${REDIS_HOST:-127.0.0.1}
  Port: ${REDIS_PORT:-6379}
  DB: 1
QueueJob:
  Redis:
    Host: ${REDIS_HOST:-127.0.0.1}
    Port: ${REDIS_PORT:-6379}
    DB: 0
  ReportWorker:
    Enabled: ${REPORT_WORKER_ENABLED:-true}
    QueueWeight: 2
    RunConcurrency: ${REPORT_RUN_WORKER_CONCURRENCY:-4}
    ExportConcurrency: ${REPORT_EXPORT_WORKER_CONCURRENCY:-2}

ReportCenter:
  Enabled: ${REPORT_CENTER_ENABLED:-true}

MallWeather:
  Enabled: ${MALL_WEATHER_ENABLED:-false}
  FeishuEnabled: false
  Provider: caiyun
  CoverageRadiusM: 1000
  SamplingMode: center
  DefaultDetailProfile: full
  FastCron: "*/10 * * * *"
  FullCron: "7 * * * *"
  HourlySteps: 360
  DailySteps: 15
  Unit: metric:v2
  AlertEnabled: true
  AlertMissingGraceSeconds: ${MALL_WEATHER_ALERT_MISSING_GRACE_SECONDS:-1800}
  FetchTimeoutSeconds: 10
  MaxAttempts: 3
  WorkerConcurrency: 20
  OutboxPollIntervalMS: 1000
  OutboxLockTimeoutSeconds: 60
  OutboxBatchSize: 100
  OutboxRetryBaseSeconds: 5
  OutboxRetryMaxSeconds: 300
  ScheduleDBTimeoutSeconds: ${MALL_WEATHER_SCHEDULE_DB_TIMEOUT_SECONDS:-8}
  RawRetentionDays: 30
  ForecastVersionRetentionDays: 30

Caiyun:
  BaseURL: https://api.caiyunapp.com
  QPS: ${CAIYUN_QPS:-0}

Amap:
  BaseURL: https://restapi.amap.com

Youzan:
  ClientID: ${YOUZAN_CLIENT_ID:-}
  ClientSecret: ${YOUZAN_CLIENT_SECRET:-}
  GrantID: ${YOUZAN_GRANT_ID:-}
  TokenURL: ${YOUZAN_TOKEN_URL:-https://open.youzanyun.com/auth/token}
  OrdersURL: ${YOUZAN_ORDERS_URL:-https://open.youzanyun.com/api/youzan.trades.sold.get/4.0.4}
  DecryptURL: ${YOUZAN_DECRYPT_URL:-https://open.youzanyun.com/api/youzan.cloud.secret.decrypt.batch/1.0.0}
  DistributionCronExpr: ${YOUZAN_DISTRIBUTION_CRON_EXPR:-10 1 * * *}
  ValueCardURL: ${YOUZAN_VALUE_CARD_URL:-https://open.youzanyun.com/api/youzan.cardvoucher.valuecard.pay.rcd.bypub.search/3.0.1}
  RefundURL: ${YOUZAN_REFUND_URL:-https://open.youzanyun.com/api/youzan.trade.refund.search/3.0.1}
  NodeKdtID: ${YOUZAN_NODE_KDT_ID:-0}

DingTalk:
  Default:
    Token: ${DINGTALK_DEFAULT_TOKEN:-}
    Secret: ${DINGTALK_DEFAULT_SECRET:-}
  Xian:
    Token: ${DINGTALK_XIAN_TOKEN:-}
    Secret: ${DINGTALK_XIAN_SECRET:-}

Xian:
  AppSecret: ${XIAN_APP_SECRET:-}
  ShopID: ${XIAN_SHOP_ID:-}
  ShopName: ${XIAN_SHOP_NAME:-}
  URL: ${XIAN_URL:-}
  Sync:
    ShopCode: ${XIAN_SYNC_SHOP_CODE:-}
    Status: ${XIAN_SYNC_STATUS:-70}

HengLong:
  SalesAPIURL: ${HENGLONG_SALES_API_URL:-https://wlkpos.hanglung.com.cn:8280/HLD/salestrans.asmx}
  Username: ${HENGLONG_USERNAME:-}
  Password: ${HENGLONG_PASSWORD:-}
  LicenseKey: ${HENGLONG_LICENSE_KEY:-}
  StoreCode: ${HENGLONG_STORE_CODE:-}
  TillID: ${HENGLONG_TILL_ID:-01}
  MallItemCode: ${HENGLONG_MALL_ITEM_CODE:-}
  MallID: ${HENGLONG_MALL_ID:-}
  Cashier: ${HENGLONG_CASHIER:-}
  PLUCode: ${HENGLONG_PLU_CODE:-}
  RefundStoreCode: ${HENGLONG_REFUND_STORE_CODE:-}
  RefundMallItemCode: ${HENGLONG_REFUND_MALL_ITEM_CODE:-}
  Sync:
    ShopCode: ${HENGLONG_SYNC_SHOP_CODE:-}
    Status: ${HENGLONG_SYNC_STATUS:-70}
    StoreCode: ${HENGLONG_SYNC_STORE_CODE:-}
    MallItemCode: ${HENGLONG_SYNC_MALL_ITEM_CODE:-}

Qimai:
  OpenID: ${QIMAI_OPEN_ID:-}
  GrantCode: ${QIMAI_GRANT_CODE:-}
  OpenKey: ${QIMAI_OPEN_KEY:-}
  Nonce: ${QIMAI_NONCE:-11886}
  OrderDetailURL: ${QIMAI_ORDER_DETAIL_URL:-https://openapi.qmai.cn/v3/order/getDetail}
  BusinessRecordURL: ${QIMAI_BUSINESS_RECORD_URL:-https://openapi.qmai.cn/v3/dataone/finance/summary/businessRecord}

Bojun:
  BaseURL: ${BOJUN_BASE_URL:-http://47.116.189.190:9100/bos/standard}
  AppKey: ${BOJUN_APP_KEY:-}
  Secret: ${BOJUN_SECRET:-}
  Format: ${BOJUN_FORMAT:-json}
  TimeoutSeconds: ${BOJUN_TIMEOUT_SECONDS:-10}
  OrderMethod: ${BOJUN_ORDER_METHOD:-/retail/middleretail.query}
  OrderPageSize: ${BOJUN_ORDER_PAGE_SIZE:-100}
  OrderLookbackMinutes: ${BOJUN_ORDER_LOOKBACK_MINUTES:-1}
  OrderMaxPages: ${BOJUN_ORDER_MAX_PAGES:-20}
  OrderCronExpr: "${BOJUN_ORDER_CRON_EXPR:-0 */1 * * * *}"

ShanghaiMall:
  TimeoutSeconds: ${SHANGHAI_MALL_TIMEOUT_SECONDS:-10}
  Syandata:
    URL: ${SHANGHAI_PANLONG_SYANDATA_URL:-http://api.syandata.com/oapi/rest}
  Jialicheng:
    LoginURL: ${SHANGHAI_JIALICHENG_KERRY_LOGIN_URL:-}
    SalesURL: ${SHANGHAI_JIALICHENG_KERRY_SALES_URL:-}
  Qiantan:
    TokenURL: ${SHANGHAI_QIANTAN_XIAN_TOKEN_URL:-}
    PostURL: ${SHANGHAI_QIANTAN_XIAN_POST_URL:-}
  Shangsheng:
    URL: ${SHANGHAI_SHANGSHENG_URL:-}
  XinjiaCenter:
    URL: ${SHANGHAI_XINJIA_CENTER_URL:-}
    ProductCode: ${SHANGHAI_XINJIA_CENTER_PRODUCT_CODE:-}
    StoreCode: ${SHANGHAI_XINJIA_CENTER_STORE_CODE:-}
    TenantCode: ${SHANGHAI_XINJIA_CENTER_TENANT_CODE:-}
    Authorization: ${SHANGHAI_XINJIA_CENTER_AUTHORIZATION:-}

Storage:
  Driver: ${STORAGE_DRIVER:-local}
  OSS:
    Enabled: ${ALIYUN_OSS_ENABLED:-false}
    # Region uses cn-shanghai; endpoint uses https://oss-cn-shanghai.aliyuncs.com.
    # If backend runs on Alibaba Cloud ECS in the same region as the bucket,
    # set ALIYUN_OSS_USE_INTERNAL=true to upload through
    # https://oss-cn-shanghai-internal.aliyuncs.com.
    Region: ${ALIYUN_OSS_REGION:-cn-shanghai}
    Endpoint: ${ALIYUN_OSS_ENDPOINT:-https://oss-cn-shanghai.aliyuncs.com}
    Bucket: ${ALIYUN_OSS_BUCKET:-}
    CDNBaseURL: ${ALIYUN_OSS_CDN_BASE_URL:-}
    Prefix: ${ALIYUN_OSS_PREFIX:-data-warehouse}
    UseInternal: ${ALIYUN_OSS_USE_INTERNAL:-false}
    UseCName: ${ALIYUN_OSS_USE_CNAME:-false}
    DisableSSL: ${ALIYUN_OSS_DISABLE_SSL:-false}
    ConnectTimeoutSeconds: ${ALIYUN_OSS_CONNECT_TIMEOUT_SECONDS:-10}
    ReadWriteTimeoutSeconds: ${ALIYUN_OSS_READ_WRITE_TIMEOUT_SECONDS:-300}
    MultipartThresholdBytes: ${ALIYUN_OSS_MULTIPART_THRESHOLD_BYTES:-67108864}
    PartSizeBytes: ${ALIYUN_OSS_PART_SIZE_BYTES:-67108864}
    ParallelNum: ${ALIYUN_OSS_PARALLEL_NUM:-3}
    EnableCheckpoint: ${ALIYUN_OSS_ENABLE_CHECKPOINT:-true}
    CheckpointDir: ${ALIYUN_OSS_CHECKPOINT_DIR:-}
