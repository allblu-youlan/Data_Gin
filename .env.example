# App
TZ=
ENV=
DEBUG=
APP_URL=
APP_PORT=
APP_READ_HEADER_TIMEOUT=10
APP_IDLE_TIMEOUT=75
GIN_MODE=
HTTP_PORT=
HTTPS_PORT=
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://shop-test.youlankids.com
AUTO_MIGRATE_ON_STARTUP=false
REPORT_CENTER_ENABLED=true
REPORT_WORKER_ENABLED=true
# AES-256 keys used only to encrypt report Oracle passwords stored in MySQL.
# Generate a 32-byte random key, encode it as standard Base64, and rotate by adding a new version.
REPORT_CREDENTIAL_KEY_VERSION=key-v1
REPORT_CREDENTIAL_KEYS_JSON=
# Independent AES-256 keyring for sensitive values submitted when a report runs.
REPORT_PARAMETER_KEY_VERSION=key-v1
REPORT_PARAMETER_KEYS_JSON=
# Default Oracle datasource used only by configurable report input queries.
REPORT_INPUT_ORACLE_HOST=
REPORT_INPUT_ORACLE_PORT=1521
REPORT_INPUT_ORACLE_SERVICE_NAME=
REPORT_INPUT_ORACLE_SID=
REPORT_INPUT_ORACLE_USERNAME=
REPORT_INPUT_ORACLE_PASSWORD=
REPORT_INPUT_ORACLE_TIMEZONE=Asia/Shanghai
REPORT_INPUT_ORACLE_CONNECT_TIMEOUT_SECONDS=5
REPORT_INPUT_ORACLE_QUERY_TIMEOUT_SECONDS=30
REPORT_INPUT_ORACLE_MAX_OPEN_CONNECTIONS=20
REPORT_INPUT_ORACLE_MAX_IDLE_CONNECTIONS=10
REPORT_INPUT_ORACLE_CONNECTION_LIFETIME_SECONDS=1800
REPORT_INPUT_ORACLE_CONNECTION_IDLE_SECONDS=300
REPORT_INPUT_ORACLE_PREFETCH_ROWS=1000
REPORT_INPUT_ORACLE_ARRAY_SIZE=1000
# Legacy compatibility only: optional JSON object of query name -> SELECT.
# New query definitions should be managed on the report configuration page.
REPORT_INPUT_QUERIES_JSON=

# SSL
SSL_ENABLED=
SSL_DOMAIN=
SSL_PORT=

# Database
# Production must use the private DNS endpoint of a highly available MySQL
# cluster. Do not configure a single-node public IP here.
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=10
DB_MAX_LIFE_SECONDS=300
DB_MAX_IDLE_SECONDS=90
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30
DB_MIGRATION_IO_TIMEOUT_SECONDS=1800
DB_REJECT_READ_ONLY=true

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

# JWT
JWT_KEY=

# Alibaba Cloud SMS
# Create a RAM user with the minimum SMS SendSms permission. The approved
# template must use the variable name "code" for the six-digit verification code.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com

# Mall weather providers
# Enables the geocode/weather workers and outbox dispatcher.
MALL_WEATHER_ENABLED=
# Required when MALL_WEATHER_ENABLED=true.
# Amap geocoding Web Service key for mall address -> longitude/latitude.
AMAP_WEB_SERVICE_KEY=
# Caiyun App Key used in v2.6 weather and v3 life-index request paths.
CAIYUN_APP_KEY=
# Caiyun App Secret used only for HMAC-SHA256 request signatures.
CAIYUN_APP_SECRET=
# Required when MALL_WEATHER_ENABLED=true; set this to the QPS allowed by your Caiyun plan.
CAIYUN_QPS=
# Optional grace period before a Caiyun alert missing from new responses is marked inactive.
MALL_WEATHER_ALERT_MISSING_GRACE_SECONDS=1800

# Feishu weather destination
# Required only when MallWeather.FeishuEnabled=true.
# Feishu app credentials for tenant access token.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Target weather spreadsheet token.
FEISHU_WEATHER_SPREADSHEET_TOKEN=
# Sheet IDs for each weather dataset.
FEISHU_WEATHER_REALTIME_SHEET_ID=
FEISHU_WEATHER_MINUTELY_SHEET_ID=
FEISHU_WEATHER_HOURLY_SHEET_ID=
FEISHU_WEATHER_DAILY_SHEET_ID=
FEISHU_WEATHER_ALERT_SHEET_ID=
FEISHU_WEATHER_LIFE_INDEX_SHEET_ID=
# Optional folder token for Feishu weather resources; not required at startup.
FEISHU_WEATHER_FOLDER_TOKEN=

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=

# Youzan
YOUZAN_CLIENT_ID=
YOUZAN_CLIENT_SECRET=
YOUZAN_GRANT_ID=
YOUZAN_TOKEN_URL=
YOUZAN_ORDERS_URL=
YOUZAN_DECRYPT_URL=
YOUZAN_DISTRIBUTION_CRON_EXPR=
YOUZAN_VALUE_CARD_URL=
YOUZAN_REFUND_URL=
YOUZAN_NODE_KDT_ID=

# DingTalk
DINGTALK_DEFAULT_TOKEN=
DINGTALK_DEFAULT_SECRET=
DINGTALK_XIAN_TOKEN=
DINGTALK_XIAN_SECRET=

# Xian
XIAN_APP_SECRET=
XIAN_SHOP_ID=
XIAN_SHOP_NAME=
XIAN_URL=
XIAN_SYNC_SHOP_CODE=
XIAN_SYNC_STATUS=

# HengLong
HENGLONG_SALES_API_URL=
HENGLONG_USERNAME=
HENGLONG_PASSWORD=
HENGLONG_LICENSE_KEY=
HENGLONG_STORE_CODE=
HENGLONG_TILL_ID=
HENGLONG_MALL_ITEM_CODE=
HENGLONG_MALL_ID=
HENGLONG_CASHIER=
HENGLONG_PLU_CODE=
HENGLONG_REFUND_STORE_CODE=
HENGLONG_REFUND_MALL_ITEM_CODE=
HENGLONG_SYNC_SHOP_CODE=
HENGLONG_SYNC_STATUS=
HENGLONG_SYNC_STORE_CODE=
HENGLONG_SYNC_MALL_ITEM_CODE=

# Qimai
QIMAI_OPEN_ID=
QIMAI_GRANT_CODE=
QIMAI_OPEN_KEY=
QIMAI_NONCE=
QIMAI_ORDER_DETAIL_URL=
QIMAI_BUSINESS_RECORD_URL=

# Bojun
BOJUN_BASE_URL=
BOJUN_APP_KEY=
BOJUN_SECRET=
BOJUN_FORMAT=
BOJUN_TIMEOUT_SECONDS=
BOJUN_ORDER_METHOD=/retail/middleretail.query
BOJUN_ORDER_PAGE_SIZE=
BOJUN_ORDER_LOOKBACK_MINUTES=
BOJUN_ORDER_MAX_PAGES=
BOJUN_ORDER_CRON_EXPR=

# Shanghai mall push
SHANGHAI_MALL_TIMEOUT_SECONDS=
SHANGHAI_PANLONG_SYANDATA_URL=
SHANGHAI_PANLONG_SYANDATA_APP_KEY=
SHANGHAI_PANLONG_SYANDATA_APP_ID=
SHANGHAI_PANLONG_SYANDATA_APP_SECRET=
SHANGHAI_PANLONG_SYANDATA_TERMINAL_NUMBER=
SHANGHAI_XINTIANDI_SYANDATA_URL=
SHANGHAI_XINTIANDI_SYANDATA_APP_KEY=
SHANGHAI_XINTIANDI_SYANDATA_APP_ID=
SHANGHAI_XINTIANDI_SYANDATA_APP_SECRET=
SHANGHAI_XINTIANDI_SYANDATA_TERMINAL_NUMBER=
SHANGHAI_QIANTAN_XIAN_TOKEN_URL=
SHANGHAI_QIANTAN_XIAN_POST_URL=
SHANGHAI_QIANTAN_XIAN_ACCOUNT=
SHANGHAI_QIANTAN_XIAN_PASSWORD=
SHANGHAI_QIANTAN_XIAN_SHOP_ID=
SHANGHAI_QIANTAN_XIAN_BRANCH_ID=
SHANGHAI_QIANTAN_XIAN_NUM=
SHANGHAI_SHANGSHENG_URL=
SHANGHAI_SHANGSHENG_GID=
SHANGHAI_SHANGSHENG_MID=
SHANGHAI_SHANGSHENG_VSN=
SHANGHAI_XINJIA_CENTER_URL=
SHANGHAI_XINJIA_CENTER_PRODUCT_CODE=
SHANGHAI_XINJIA_CENTER_STORE_CODE=
SHANGHAI_XINJIA_CENTER_TENANT_CODE=
SHANGHAI_XINJIA_CENTER_AUTHORIZATION=
SHANGHAI_XINJIA_CENTER_BOJUN_STORE_CODE=
SHANGHAI_JIALICHENG_KERRY_LOGIN_URL=
SHANGHAI_JIALICHENG_KERRY_SALES_URL=
SHANGHAI_JIALICHENG_KERRY_PROGRAM_NAME=
SHANGHAI_JIALICHENG_KERRY_DEVICE_ID=
SHANGHAI_JIALICHENG_KERRY_ACTIVATION_CODE=
SHANGHAI_JIALICHENG_KERRY_LOCATION_CODE=
SHANGHAI_JIALICHENG_KERRY_ITEM_CODE=
SHANGHAI_JIALICHENG_KERRY_CASHIER=
SHANGHAI_JIALICHENG_KERRY_STORE_CODE=
SHANGHAI_JIALICHENG_KERRY_TILL_ID=
SHANGHAI_JIALICHENG_KERRY_STAFF_CODE=
SHANGHAI_JIALICHENG_KERRY_TENDER_CODE=

# Static storage / Aliyun OSS
# Shared OSS settings. Mall weather raw snapshots and exports reuse these
# existing OSS variables; there is no separate weather-specific OSS credential.
STORAGE_DRIVER=local
ALIYUN_OSS_ENABLED=false
ALIYUN_OSS_REGION=cn-shanghai
ALIYUN_OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_CDN_BASE_URL=
ALIYUN_OSS_PREFIX=data-warehouse
ALIYUN_OSS_USE_INTERNAL=false
ALIYUN_OSS_USE_CNAME=false
ALIYUN_OSS_DISABLE_SSL=false
ALIYUN_OSS_CONNECT_TIMEOUT_SECONDS=10
ALIYUN_OSS_READ_WRITE_TIMEOUT_SECONDS=300
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_SECURITY_TOKEN=
EXCEL_MATCH_OSS_UPLOAD_TIMEOUT_SECONDS=3600

# Large Excel processing temp root. In Docker, host path should be a data disk,
# and container path is the value read by the Go process.
EXCEL_TEMP_HOST_DIR=/mnt/data-warehouse-excel
DATA_WAREHOUSE_EXCEL_TEMP_DIR=/data/data-warehouse-excel
