[Unit]
Description=Host resource sampler
RequiresMountsFor=/mnt/host-monitor
ConditionPathIsMountPoint=/mnt

[Service]
Environment=LC_ALL=C S_COLORS=never
UMask=0077
Restart=always
RestartSec=10
Nice=10
IOSchedulingClass=idle
CPUQuota=10%
MemoryMax=96M
TasksMax=16
ExecStart=/bin/sh -c 'exec /usr/bin/stdbuf -oL /usr/bin/pidstat -H -h -u -r -d -p ALL 10 >> /mnt/host-monitor/pidstat.log'

[Install]
WantedBy=multi-user.target
